QRANT_API=
QRANT_URL=
NVIDIA_API=

# Primary OpenAI-compatible chat endpoint (agents)
API_KEY=
BASE_URL=
MODEL_NAME=

# Optional additional endpoints (selectable in FE / GET /api/v1/models)
# API_URL_1=http://host:port/v1
# API_KEY_1=
# MODEL_NAME_1=sun_llm/gemma-4-12b

# Browser frontend origins allowed to call FastAPI (comma-separated).
# Local Next.js:
CORS_ORIGINS=http://localhost:3000
# Production (Vercel FE + tunnel BE) — set on the self-hosted runner / GitHub Environment:
# CORS_ORIGINS=https://your-app.vercel.app,https://*.vercel.app,http://localhost:3000

# Realtime Kafka ingestion (host defaults; use kafka:29092 inside Docker network)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=aml.transactions.raw.v1
KAFKA_VALIDATED_TOPIC=aml.transactions.validated.v1
KAFKA_DLQ_TOPIC=aml.transactions.dlq.v1
KAFKA_GROUP_ID=aml-ingestion-v1
KAFKA_CLIENT_ID=aml-realtime-ingestion
KAFKA_POLL_TIMEOUT_MS=1000
KAFKA_ACK_TIMEOUT_SECONDS=10

# Realtime detection consumes KAFKA_VALIDATED_TOPIC with its own consumer group
DETECTION_DB_PATH=data/detection_queue.db
DETECTION_MODEL_PATH=model/xgb_model.json
DETECTION_ENRICHMENT_DATA_PATH=data/generated
DETECTION_ML_QUEUE_THRESHOLD=0.60
DETECTION_ML_BLOCK_THRESHOLD=0.99
DETECTION_GROUP_ID=aml-detection-v1
DETECTION_CLIENT_ID=aml-realtime-detection
DETECTION_RUN_MODE=MANUAL
DETECTION_CLAIM_LEASE_SECONDS=1800
DETECTION_RETRY_DELAY_SECONDS=300
DETECTION_MAX_ATTEMPTS=3
